# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (Project Settings > API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, bypasses RLS. Used exclusively by the
# admin dashboard API routes (app/api/admin/*). NEVER expose this to the
# browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin dashboard login (app/admin) ----------------------------------
ADMIN_NAME=Sushil
ADMIN_EMAIL=sushilparajuli235@gmail.com
# bcrypt hash of the admin password — generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# IMPORTANT: escape every literal $ in the hash as \$ (e.g. \$2b\$12\$...) —
# Next.js's env loader does $VAR-style interpolation and will silently
# blank out unescaped $-segments, breaking the hash.
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash-with-escaped-dollars
# Random long string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-secret

# --- Google Sheets sync (optional — every listing create/edit/delete   ---
# --- mirrors to a Google Sheet if these are set; skipped silently if   ---
# --- not). See README.md "Google Sheets sync" section for setup steps. ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# The private_key field from the service account's JSON key, including the
# -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY----- lines. Keep the
# \n line breaks literal (as a single-line env value) — the app converts
# them back to real newlines at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR KEY HERE\n-----END PRIVATE KEY-----\n"
# The long ID in the sheet's URL: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your-google-sheet-id
# Tab name to write into. Defaults to "Sheet1" if unset.
GOOGLE_SHEET_NAME=Sheet1
