# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (Project Settings > API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, bypasses RLS. Used exclusively by the
# admin dashboard API routes (app/api/admin/*). NEVER expose this to the
# browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin dashboard login (app/admin) ----------------------------------
ADMIN_NAME=Sushil
ADMIN_EMAIL=sushilparajuli235@gmail.com
# bcrypt hash of the admin password — generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# IMPORTANT: escape every literal $ in the hash as \$ (e.g. \$2b\$12\$...) —
# Next.js's env loader does $VAR-style interpolation and will silently
# blank out unescaped $-segments, breaking the hash.
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash-with-escaped-dollars
# Random long string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-secret
